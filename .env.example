# -----------------------------------------------------------------------------
# FILOS CRM Web — public Firebase web config (Phase J2)
# These are client-visible Firebase web keys (not the Admin service account).
# Copy to .env / .env.local. Never commit real production values if policy forbids.
# Generate: Firebase Console → Project settings → Your apps → Web app
# VAPID: Project settings → Cloud Messaging → Web Push certificates
# -----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
